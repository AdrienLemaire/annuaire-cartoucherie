---
// src/pages/carte.astro
// Composition authority: docs/mockups/final/carte.html. Markup and class lists
// are copied from it; deviations from the mockup and from task-10-brief.md's
// own sample code are named in task-10-report.md, per the fidelity rule
// (task-10-brief.md, "The fidelity rule").
//
// The map is real: OpenStreetMap streets, tram, river and parks inside fixed
// bounds (src/assets/quartier.svg, rendered once by scripts/map-svg.mjs),
// inlined and drawn 1:1 in a horizontally scrolling box, so street names stay
// legible and 44 px pins stay apart on a phone. Each pin is the member's real
// lat/lng in Web Mercator (src/lib/plan.ts). Inline SVG, not Leaflet or
// MapLibre (either alone exceeds the 40 KB JS budget) nor a raster tile image
// (it became the LCP element and broke the 2 s LCP budget): zero JS, no
// third-party request at runtime, sharp under pinch-zoom. Panning is the
// box's own scroll; a `#pin-<slug>` fragment scrolls it to the pin with no
// script, since each pin's .ancre sits on the pin itself.
//
// The plan pin, its label and its sheet row used to be linked by :target alone,
// with one generated CSS rule block per pinned member (task-10-brief.md, "No
// mapping library in v1"; src/lib/plan.ts's buildTargetCss, served from
// src/pages/carte.css.ts). Elegant at twelve members, unshippable at two
// hundred: 8 KB of generated CSS grew to 124 KB (task-14-report.md's scale
// rehearsal), because CSS selectors are static and a rule matching "the pin
// whose slug equals this anchor's slug" cannot be written generically — it can
// only be enumerated, once per member.
//
// task-15-brief.md's fix keeps as much of that as CSS can genuinely do
// generically, and spends the minimum JS on what it can't:
//   - The PIN still needs no script at all. Each pin's own `.ancre` anchor is
//     now its immediately preceding sibling (not a same-id duplicate, which
//     would be invalid HTML and an axe duplicate-id violation) — a single
//     generic `.ancre:target + .epingle-lien` rule, in <style is:global>
//     below, matches whichever pin was targeted, without knowing its slug.
//   - The ROW cannot be reached the same way: it lives in a different subtree
//     (.feuille, not .plan) and is reordered at runtime by src/client/
//     geolocate.ts, so no fixed sibling relationship to its pin's anchor
//     exists for CSS to exploit. src/client/carte-select.ts (dynamically
//     imported below, for the same CSP reason as geolocate.ts) reads
//     location.hash on load and on "hashchange" and toggles one attribute,
//     [data-selected], on the [data-sheet] row whose data-m matches — the
//     same data-m/data-slug attributes carte.astro already wrote for other
//     reasons, not new ones added for this. Total cost: ~0.3 KB gzip of JS,
//     of 40 KB budgeted (task-15-report.md); the plan pin itself still works
//     with JavaScript disabled.
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import Toggletip from "../components/Toggletip.astro";
import MemberCard from "../components/MemberCard.astro";
import MemberRow from "../components/MemberRow.astro";
import { COPY } from "../lib/copy";
import { loadCategories, loadMembers } from "../lib/collections";
import { hasAddress, memberCountParts, sortByDistance } from "../lib/members";
import { HALL, isPinned, projectOnMap } from "../lib/plan";
import Quartier from "../assets/quartier.svg";

const [members, categories] = await Promise.all([loadMembers(), loadCategories()]);

const withAddress = sortByDistance(members.filter(hasAddress));
const withoutAddress = members.filter((m) => !hasAddress(m));

// The page's own count-dependent sentences (task-10-report.md finding 1) —
// computed here, once, from memberCountParts' own {count, noun}, never the
// mockup's hardcoded "Dix"/"Deux".
const addressParts = memberCountParts(
  withAddress.length,
  withAddress.map((m) => m.genre),
);

// isPinned (src/lib/plan.ts) is the one place that decides "is there a public
// point to show".
const hall = projectOnMap({ slug: "halle", ...HALL });
const pins = members.filter(isPinned).map((m) => ({
  member: m,
  position: projectOnMap(m),
  icon: categories.find((c) => c.slug === m.categories[0])?.icon,
}));
---

<BaseLayout
  title={`${COPY.mapTitle} — Annuaire de la Cartoucherie`}
  description={COPY.mapDescription}
  header={{ href: "/annuaire", label: COPY.headerBackDirectory, srOnly: COPY.headerBackDirectorySr }}
>
  <div class="mx-auto max-w-[1160px] px-5 pt-6">
    <h1 class="ff text-nom sm:text-grand text-teal-900">{COPY.mapTitle}</h1>
    <p class="mt-2.5 text-corps text-neutre-800 max-w-[62ch]">
      {COPY.mapIntroAddress(addressParts.count, addressParts.noun)}
      {withoutAddress.length > 0 && ` ${COPY.mapIntroItinerant(withoutAddress.length)}`}
    </p>

    <div class="mt-4 flex flex-wrap items-center gap-2.5">
      <button
        type="button"
        data-geolocate
        class="inline-flex items-center gap-2 min-h-[48px] px-5 rounded-full text-corps font-semibold text-white bg-teal-700 hover:bg-teal-600"
      >
        <Icon name="signal" class="w-[18px] h-[18px]" />
        {COPY.mapUseMyLocation}
      </button>
      <Toggletip id="geo-prive" label={COPY.mapGeoPrivacy}>{COPY.mapGeoLocal}</Toggletip>
    </div>
    <p data-geo-status role="status" hidden class="mt-3 rounded-[14px] bg-teal-50 px-4 py-3 text-corps text-teal-900">
      <span data-geo-granted hidden>{COPY.mapGeoGranted}</span>
      <span data-geo-denied hidden>{COPY.mapGeoDenied}</span>
    </p>
  </div>

  <div
    id="quartier"
    class="relative mx-auto max-w-[1160px] px-5 mt-5 lg:grid lg:grid-cols-[minmax(0,520px)_minmax(0,1fr)] lg:gap-8 lg:items-start"
  >
    <div class="colonne-plan lg:sticky lg:top-24">
      <div
        data-map
        class="overflow-x-auto bg-neutre-200 -mx-5 sm:mx-0 rounded-none sm:rounded-[22px] sm:border sm:border-neutre-300"
      >
        <div class="plan relative w-max">
          <Quartier role="img" aria-label={COPY.mapPlanAlt} class="block max-w-none" />

          <span
            data-halle
            class="absolute grid place-items-center w-11 h-11 -ml-[22px] -mt-[22px] pointer-events-none"
            style={`left:${hall.left}%; top:${hall.top}%`}
          >
            <span
              class="block w-[18px] h-[18px] rounded-full bg-teal-700"
              style="box-shadow: 0 0 0 4px #fff, 0 0 0 7px oklch(53% .09 196/.35)"
            />
          </span>
          <p
            class="absolute whitespace-nowrap rounded-full bg-white px-2.5 py-1 text-[16px] font-semibold text-teal-800 pointer-events-none"
            style={`left:calc(${hall.left}% - 18px); top:${hall.top}%; transform:translate(-100%,-50%); box-shadow: var(--shadow-carte)`}
          >
            {COPY.mapHall}
          </p>

          {
            // .ancre immediately precedes its own .epingle-lien: the sole reason
            // this pairing works with one generic CSS rule instead of one
            // generated per member (see this file's own header comment and
            // <style is:global> below, ".ancre:target + .epingle-lien").
            pins.map((p) => (
              <>
                <span class="ancre" id={`pin-${p.member.slug}`} style={`left:${p.position.left}%; top:${p.position.top}%`} />
                <a
                  data-m={p.member.slug}
                  href={`#pin-${p.member.slug}`}
                  class="epingle-lien absolute z-10 grid place-items-center w-11 h-11 -ml-[22px] -mt-[22px]"
                  style={`left:${p.position.left}%; top:${p.position.top}%`}
                  aria-label={COPY.mapPinAria(p.member.nom, p.member.metier, p.member.distance)}
                >
                  <span class="epingle grid place-items-center w-9 h-9 rounded-full bg-white text-teal-700">
                    {p.icon && <Icon raw={p.icon} class="w-[18px] h-[18px]" />}
                  </span>
                  <span class={`etiq ${p.position.etiqClass}`} aria-hidden="true">
                    {p.member.nom} · {COPY.cardDistance(p.member.distance)}
                  </span>
                </a>
              </>
            ))
          }
        </div>
      </div>

      <p class="mt-2.5 flex flex-wrap items-center justify-between gap-x-4 gap-y-1 text-[16px] text-neutre-700">
        <a
          href="https://www.openstreetmap.org/copyright"
          class="inline-flex items-center min-h-[44px] underline underline-offset-4 decoration-neutre-400 hover:decoration-neutre-700"
        >
          {COPY.mapAttribution}
        </a>
        <a
          href="#quartier"
          class="reset inline-flex items-center gap-1.5 min-h-[44px] font-semibold text-teal-700 underline underline-offset-4 decoration-teal-300 hover:decoration-teal-600"
        >
          <Icon name="fermer" class="w-4 h-4" />
          {COPY.mapClearSelection}
        </a>
      </p>
    </div>

    <div class="feuille relative mt-6 lg:mt-0">
      <h2 id="t-proches" class="ff min-w-0 break-words text-nom text-teal-900">
        <span data-from-hall>{COPY.mapFromHall}</span>
        <span data-from-you hidden>{COPY.mapFromYou}</span>
      </h2>
      <div class="filet h-[3px] w-16 rounded-full mt-2.5 mb-5" />
      <ol data-sheet aria-labelledby="t-proches" class="flex flex-col gap-3 list-none p-0 m-0">
        {
          withAddress.map((m) => (
            <li data-slug={m.slug} data-lat={m.lat} data-lng={m.lng}>
              <MemberRow member={m} variant="carte" />
            </li>
          ))
        }
      </ol>
    </div>
  </div>

  {
    withoutAddress.length > 0 && (
      <section class="mt-10 bg-neutre-100" aria-labelledby="t-chezvous">
        <div class="mx-auto max-w-[1160px] px-5 py-8">
          <h2 id="t-chezvous" class="ff text-nom text-teal-900">{COPY.mapTheyComeToYou}</h2>
          <div class="filet h-[3px] w-16 rounded-full mt-2.5 mb-4" />
          <ul class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4 list-none p-0 m-0">
            {withoutAddress.map((m) => (
              <li>
                <MemberCard member={m} categories={categories} fill />
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  {
    // Dynamic import, not a static one: a static `import "../client/geolocate"`
    // here compiled to an inline module script with no
    // src= (Astro inlines any hoisted script whose own chunk statically
    // imports nothing else and stays under Vite's 4 KB assetsInlineLimit —
    // node_modules/astro/dist/core/build/plugins/plugin-scripts.js,
    // shouldInlineScriptChunk) — and this project's CSP (public/_headers,
    // script-src 'self', no security.csp hash/nonce) blocks an inline script
    // outright. Reported task-13-report.md; fixed here the same way
    // BaseLayout.astro's own scripts were: a dynamic import carries a
    // dynamicImports entry, which unconditionally disqualifies the chunk
    // from inlining, so it ships as the external file CSP actually permits.
  }
  <script>
    void import("../client/geolocate");
  </script>
  {
    // Same reason as the dynamic import right above: a static import would
    // let Astro inline this tiny chunk straight into the HTML, which the
    // production CSP (script-src 'self') blocks.
  }
  <script>
    void import("../client/carte-select");
  </script>

  <style is:global>
    /* les ancres de :target ne prennent aucune place ; elles nomment une épingle
       dans l'URL et sont posées sur elle (style en ligne, par rapport à .plan) :
       suivre #pin-<slug> fait défiler la page ET la fenêtre de la carte jusqu'à
       l'épingle, sans script. Les marges la gardent loin des bords et sous l'en-tête
       collant. #quartier garde position:relative pour les règles :has() ci-dessous. */
    #quartier {
      position: relative;
    }
    .ancre {
      position: absolute;
      width: 0;
      height: 0;
      scroll-margin-block: 40vh;
      scroll-margin-inline: min(40vw, 200px);
    }

    /* le fond de carte (src/assets/quartier.svg) : ses classes nomment ce que
       chaque tracé représente, les couleurs restent celles du thème */
    .plan svg path {
      fill: none;
      stroke-linecap: round;
      stroke-linejoin: round;
    }
    .plan svg .g {
      fill: var(--color-sauge-100);
    }
    .plan svg .w {
      fill: var(--color-teal-100);
    }
    .plan svg .s,
    .plan svg .r,
    .plan svg .p {
      stroke: #fff;
    }
    .plan svg .s {
      stroke-width: 3;
    }
    .plan svg .r {
      stroke-width: 7;
    }
    .plan svg .p {
      stroke-width: 11;
    }
    .plan svg .m {
      stroke: var(--color-neutre-300);
      stroke-width: 12;
    }
    .plan svg .t {
      stroke: var(--color-teal-600);
      stroke-width: 2;
      stroke-dasharray: 7 7;
    }
    .plan svg .rues {
      font-family: var(--font-sans);
      font-weight: 600;
      fill: var(--color-neutre-700);
      stroke: var(--color-neutre-200);
      stroke-width: 3;
      paint-order: stroke;
    }

    /* une épingle : disque blanc, anneau teal. L'état sélectionné — le SEUL objet
       orange de cette page avec le filet — est posé par une seule règle générique
       plus bas (".ancre:target + .epingle-lien"), pas une par membre. */
    .epingle {
      box-shadow: 0 0 0 2px var(--color-teal-600), var(--shadow-carte);
      transition:
        transform 0.18s ease,
        box-shadow 0.18s ease;
    }
    .epingle-lien:hover .epingle {
      transform: scale(1.08);
    }
    .etiq {
      position: absolute;
      top: calc(100% - 4px);
      left: 50%;
      transform: translate(-50%, 4px);
      white-space: nowrap;
      border-radius: 9999px;
      background: #fff;
      padding: 3px 10px;
      font-size: 16px;
      font-weight: 600;
      color: var(--color-teal-900);
      box-shadow: var(--shadow-carte);
      opacity: 0;
      transition:
        opacity 0.18s ease,
        transform 0.18s ease;
      pointer-events: none;
    }
    .etiq--c {
      transform: translate(-50%, 4px);
    }
    .etiq--g {
      left: 2px;
      transform: translate(0, 4px);
    }
    .etiq--d {
      left: auto;
      right: 2px;
      transform: translate(0, 4px);
    }
    .rangee {
      transition:
        box-shadow 0.18s ease,
        background-color 0.18s ease;
    }

    /* tant que rien n'est sélectionné, il n'y a rien à réafficher */
    #quartier:not(:has(.ancre:target)) .reset {
      display: none;
    }
    /* une sélection en cours : le reste du plan recule d'un cran */
    #quartier:has(.ancre:target) .epingle-lien {
      opacity: 0.55;
    }
    #quartier:has(.ancre:target) .epingle-lien:hover {
      opacity: 1;
    }

    /* L'épingle ciblée (task-15-brief.md — remplace les six règles jadis
       générées une fois par voisin épinglé : .ancre étant l'exact frère
       précédent de .epingle-lien dans le DOM, un seul sélecteur générique la
       retrouve, quel que soit son slug ni leur nombre. Préfixé par
       "#quartier .plan" pour l'emporter, quel que soit l'ordre des règles,
       sur l'assombrissement ci-dessus — les deux ont sinon la même
       spécificité. */
    #quartier .plan .ancre:target + .epingle-lien {
      z-index: 30;
      opacity: 1;
    }
    #quartier .plan .ancre:target + .epingle-lien .epingle {
      transform: scale(1.14);
      box-shadow: 0 0 0 3px var(--color-orange-500), var(--shadow-flottant);
    }
    #quartier .plan .ancre:target + .epingle-lien .etiq {
      opacity: 1;
    }
    #quartier .plan .ancre:target + .epingle-lien .etiq--c {
      transform: translate(-50%, 0);
    }
    #quartier .plan .ancre:target + .epingle-lien .etiq--g,
    #quartier .plan .ancre:target + .epingle-lien .etiq--d {
      transform: translate(0, 0);
    }

    /* La ligne de la feuille : la seule moitié du lien que le CSS seul ne peut
       pas faire (elle vit dans un autre sous-arbre que l'épingle, et
       src/client/geolocate.ts la déplace au tri par position) —
       src/client/carte-select.ts pose [data-selected]. */
    .feuille [data-m][data-selected] {
      background: var(--color-teal-50);
      box-shadow: 0 0 0 2px var(--color-teal-600), var(--shadow-carte);
    }
  </style>
</BaseLayout>
