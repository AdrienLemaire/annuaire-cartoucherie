---
// src/pages/categorie/[slug].astro
// One prerendered page per category (getStaticPaths below emits all ten, even
// the one nobody has joined yet — withCounts keeps a zero-count category
// rather than dropping it, so the page for it exists and explains itself
// instead of 404ing). No mockup specimen composes this page on its own:
// annuaire.html is a single page that narrows itself to one category via
// ?cat=…, so this route's markup is that same composition, scoped server-side
// to one category instead of client-side to all of them. The count line
// already says "nobody yet"; the empty state only adds NeedsIndex.astro's
// own suggest link, same copy, same mailto: builder. Carries the same
// search form as /annuaire, in the same header slot: one system, not two —
// the search is never a mechanism this page's own filtering rivals.
import BaseLayout from "../../layouts/BaseLayout.astro";
import MemberRow from "../../components/MemberRow.astro";
import SearchBar from "../../components/SearchBar.astro";
import SearchResults from "../../components/SearchResults.astro";
import { COPY } from "../../lib/copy";
import { mailtoHref } from "../../lib/contact";
import { loadCategories, loadMembers } from "../../lib/collections";
import { formatMemberCount, withCounts } from "../../lib/members";

export async function getStaticPaths() {
  const [members, categories] = await Promise.all([loadMembers(), loadCategories()]);
  return withCounts(categories, members).map((category) => ({
    params: { slug: category.slug },
    props: {
      category,
      categories,
      neighbours: members.filter((m) => m.categories.includes(category.slug)),
    },
  }));
}

const { category, categories, neighbours } = Astro.props;
const count = formatMemberCount(category.count, category.genders);
---

<BaseLayout
  title={`${category.nom} — Annuaire de la Cartoucherie`}
  description={COPY.categoryDescription(category.nom, category.motsCles)}
  header={{ href: "/annuaire", label: COPY.headerBackDirectory, srOnly: COPY.headerBackDirectorySr }}
>
  <Fragment slot="header-extra">
    <div class="max-w-[720px]">
      <SearchBar />
    </div>
  </Fragment>

  <div class="mx-auto max-w-[1160px] px-5 py-7">
    <h1 class="ff text-nom text-teal-900">{category.besoin}</h1>

    <SearchResults class="mt-6 grid grid-cols-1 gap-3 mx-auto max-w-[620px] min-[940px]:max-w-none min-[940px]:grid-cols-2" />

    <div data-browse>
      {
        // This category's own count (final-fixes-report.md, I11 review follow-up):
        // stays inside [data-browse] with everything else "browsing" means on this
        // page — outside it, a search for an unrelated need would leave this
        // category's own count sitting above live results from every category,
        // the same rule annuaire.astro's own count line already follows.
      }
      <p class="mt-2 text-chapo text-neutre-800">
        {category.nom} · {count}
      </p>
      {
        category.count === 0 ? (
          <div class="colly-fond mt-6 max-w-[52ch] rounded-[20px] p-5">
            <a
              class="inline-flex min-h-[44px] items-center font-semibold text-teal-800 underline decoration-teal-400 underline-offset-4"
              href={mailtoHref(COPY.searchSuggestSubject(category.nom))}
            >
              {COPY.searchSuggest}
            </a>
          </div>
        ) : (
          <>
            <h2 id="t-liste" class="sr-only">{COPY.directoryListHeading}</h2>
            <ul aria-labelledby="t-liste" class="mt-6 grid grid-cols-1 gap-3 mx-auto max-w-[620px] min-[940px]:max-w-none min-[940px]:grid-cols-2 list-none p-0 m-0">
            {neighbours.map((m, i) => (
              <li data-member data-cat={m.categories.join(" ")}>
                <MemberRow member={m} categories={categories} priority={i === 0} />
              </li>
            ))}
            </ul>
          </>
        )
      }

      <p class="mt-8">
        <a
          class="inline-flex items-center min-h-[44px] font-semibold text-teal-700 underline decoration-teal-300 underline-offset-4 hover:decoration-teal-600"
          href="/annuaire"
        >
          {COPY.directoryAll}
        </a>
      </p>
    </div>
  </div>
  <script>
    import "../../client/live-search";
  </script>
</BaseLayout>
