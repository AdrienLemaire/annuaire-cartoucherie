---
// src/pages/annuaire.astro
// Composition authority: docs/mockups/final/annuaire.html. Its search form
// lives inside <header>, above the filet, so it stays sticky with the
// wordmark as the visitor scrolls — SiteHeader's "under" slot (this task)
// carries it there via BaseLayout's header-extra slot. The form itself keeps
// the mockup's own max-w-[720px] cap, added on the wrapper rather than inside
// SearchBar.astro (Task 5's file, reused as-is here).
//
// One system, not two: the chip rail below is real `<a href="/categorie/…">`
// links, including "Tous les métiers" (data-filter="") — /categorie/[slug] is
// a prerendered page for every category, even the one nobody has joined — so
// the page works with JavaScript disabled. A zero-count category is NOT a
// link, though: annuaire.html:388-389 renders it as a non-interactive
// `chip-vide` span, and NeedsIndex.astro already settled the same call one
// task earlier — a visitor should see "nobody here" before tapping, not
// after. It stays reachable directly at /categorie/[slug], which always
// explains itself.
//
// src/client/category-filter.ts upgrades the remaining, populated chips to
// filter in place, using data-count/data-noun/data-detail and the hidden
// [data-empty-for] blocks this frontmatter already composed in French, plus
// one generic [data-no-match] block for a filter that matches nothing at all
// (an unrecognised ?cat= value) — so the script never composes a sentence,
// only chooses which one, already written, to reveal.
//
// src/client/live-search.ts mounts into [data-results], placed as the first
// child of <section> rather than inside the sticky header the search bar
// itself lives in (Fragment slot="header-extra" below) — a results list
// growing inside a position:sticky element would push arbitrarily far down
// the viewport as the visitor scrolls. It hides [data-browse] (count, chip
// rail, map link, row list, and category-filter's own [data-empty-for]/
// [data-no-match] explanations — everything below, one wrapper) while a
// query is active, so a visitor who lands on an empty-category URL and then
// types never sees that panel stacked under live results: one rule for what
// "browsing" means, not two selectors that have to agree. category-filter.ts
// only ever toggles each block's own `hidden`; the group-level `hidden` here
// is a second, independent gate on top, so its state survives being hidden
// as a group and reappears correctly once the query is cleared.
import BaseLayout from "../layouts/BaseLayout.astro";
import CollyPanel from "../components/CollyPanel.astro";
import MemberRow from "../components/MemberRow.astro";
import SearchBar from "../components/SearchBar.astro";
import SearchResults from "../components/SearchResults.astro";
import { COPY } from "../lib/copy";
import { mailtoHref } from "../lib/contact";
import { loadCategories, loadMembers } from "../lib/collections";
import { formatMemberCount, memberCountParts, withCounts } from "../lib/members";

const [members, categories] = await Promise.all([loadMembers(), loadCategories()]);
const counted = withCounts(categories, members);
const total = memberCountParts(
  members.length,
  members.map((m) => m.genre),
);
const empty = counted.filter((c) => c.count === 0);
const populated = counted.filter((c) => c.count > 0);
---

<BaseLayout
  title={`${COPY.directoryTitle} — Annuaire de la Cartoucherie`}
  description={COPY.homeBrowseListText(members.length)}
>
  <Fragment slot="header-extra">
    <div class="max-w-[720px]">
      <SearchBar />
    </div>
  </Fragment>

  <section class="mx-auto max-w-[1160px] px-5 pt-7" aria-labelledby="t-annuaire">
    <h1 id="t-annuaire" class="ff text-nom text-teal-900 scroll-mt-[140px]">
      {COPY.directoryTitle}
    </h1>

    <SearchResults class="mt-6 grid grid-cols-1 gap-3 mx-auto max-w-[620px] min-[940px]:max-w-none min-[940px]:grid-cols-2" />

    <div data-browse>
      <p class="mt-5 flex flex-wrap items-baseline gap-x-3 gap-y-1" aria-live="polite">
        <span data-count-number class="ff tnum text-enorme text-teal-900">
          {total.count}
        </span>
        <span data-count-word class="text-chapo text-neutre-800">
          {total.noun}
        </span>
        <span data-count-detail class="w-full text-corps text-neutre-700">
          {COPY.directoryDetailDefault}
        </span>
      </p>

      <nav class="mt-5" aria-label={COPY.directoryFilterLabel}>
        <p class="text-etiquette font-semibold uppercase text-sauge-800">
          {COPY.directoryFilterLabel}
        </p>
        <ul class="mt-2 flex gap-2 overflow-x-auto py-1.5 -mx-5 px-5 sm:flex-wrap sm:overflow-visible sm:mx-0 sm:px-0 list-none m-0">
          <li>
            <a
              href="/annuaire"
              data-filter=""
              data-count={total.count}
              data-noun={total.noun}
              data-detail={COPY.directoryDetailDefault}
              class="chip whitespace-nowrap inline-flex items-center gap-2 rounded-selector px-3.5 py-2 min-h-[44px] text-[16px] font-semibold hover:bg-sauge-200"
            >
              <svg class="w-[18px] h-[18px]" aria-hidden="true">
                <use href="#i-groupe" />
              </svg>
              {COPY.directoryAllChip} <span class="tnum text-sauge-900">{members.length}</span>
            </a>
          </li>
          {populated.map((c) => {
            const parts = memberCountParts(c.count, c.genders);
            return (
              <li>
                <a
                  href={`/categorie/${c.slug}`}
                  data-filter={c.slug}
                  data-count={parts.count}
                  data-noun={parts.noun}
                  data-detail={c.nom}
                  class="chip whitespace-nowrap inline-flex items-center gap-2 rounded-selector px-3.5 py-2 min-h-[44px] text-[16px] font-semibold hover:bg-sauge-200"
                >
                  <svg class="w-[18px] h-[18px]" aria-hidden="true">
                    <use href={`#${c.icon}`} />
                  </svg>
                  {c.nom} <span class="tnum text-sauge-900">{c.count}</span>
                </a>
              </li>
            );
          })}
          {
            // Non-interactive: annuaire.html's own chip-vide, and NeedsIndex.astro's
            // precedent for the same zero-count case — greyed, no href, so the
            // visitor never taps into an empty category expecting a result.
            empty.map((c) => (
              <li>
                <span class="chip-vide whitespace-nowrap inline-flex items-center gap-2 rounded-selector bg-neutre-100 px-3.5 py-2 min-h-[44px] text-[16px] font-semibold text-neutre-600">
                  <svg class="w-[18px] h-[18px]" aria-hidden="true">
                    <use href={`#${c.icon}`} />
                  </svg>
                  {c.nom} <span class="tnum">{c.count}</span>
                </span>
              </li>
            ))
          }
        </ul>
      </nav>

      <p class="mt-4">
        <a
          href="/carte"
          class="inline-flex items-center gap-2 min-h-[44px] text-corps font-semibold text-teal-700 underline decoration-teal-300 underline-offset-4 hover:decoration-teal-600"
        >
          <svg class="w-[18px] h-[18px] text-teal-600" aria-hidden="true">
            <use href="#i-pin" />
          </svg>
          {COPY.directoryMapLink}
        </a>
      </p>

      <h2 id="t-liste" class="sr-only">{COPY.directoryListHeading}</h2>
      <ul aria-labelledby="t-liste" class="mt-6 grid grid-cols-1 gap-3 mx-auto max-w-[620px] min-[940px]:max-w-none min-[940px]:grid-cols-2 list-none p-0 m-0">
        {members.map((m, i) => (
          <li data-member data-cat={m.categories.join(" ")}>
            <MemberRow member={m} categories={categories} priority={i === 0} />
          </li>
        ))}
      </ul>

      {
        // [data-empty-for]/[data-no-match] stay inside [data-browse] too: they are
        // category-filter's own "browsing" explanations (a stale QR code, an empty
        // category), not search results — without this a visitor who lands on an
        // empty-category URL and then types would see that panel and the live
        // results stacked at once, two "nobody here" answers to two different
        // questions on screen together. category-filter.ts only ever toggles each
        // block's own `hidden`; wrapping them in a second, group-level `hidden`
        // here does not disturb that — both must be false for a block to show,
        // which is exactly "browsing AND this block's own condition".
        empty.map((c) => (
          <div
            data-empty-for={c.slug}
            data-noun={COPY.countNobody}
            data-detail={c.nom}
            hidden
            class="colly-fond mt-6 max-w-[52ch] rounded-[20px] p-5"
          >
            <p class="text-corps text-teal-950">{COPY.categoryNobody}</p>
            <a
              class="mt-3 inline-flex min-h-[44px] items-center font-semibold text-teal-800 underline decoration-teal-400 underline-offset-4"
              href={mailtoHref(COPY.searchSuggestSubject(c.nom))}
            >
              {COPY.searchSuggest}
            </a>
          </div>
        ))
      }

      <div data-no-match data-noun={COPY.countNobody} hidden class="mt-6">
        {
          // A slug in no chip and no [data-empty-for] block: not a category at
          // all — a mistyped share link or a stale QR code, not a category this
          // annuaire has ever listed. annuaire.html's own generic
          // #aucun-resultat is the "triste" Colly pose; CollyPanel.astro
          // already renders that exact specimen, reused rather than duplicated.
        }
        <CollyPanel
          pose="triste"
          title={COPY.searchEmpty}
          text={COPY.homeBrowseListText(members.length)}
        />
        <p class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-2">
          <a
            href="/annuaire"
            class="inline-flex min-h-[48px] items-center gap-2 rounded-full bg-teal-700 px-5 text-corps font-semibold text-white hover:bg-teal-600"
          >
            {COPY.directoryResetAll(formatMemberCount(members.length, members.map((m) => m.genre)))}
          </a>
          <a
            href={mailtoHref(COPY.searchNoMatchSubject)}
            class="inline-flex min-h-[44px] items-center font-semibold text-teal-800 underline decoration-teal-400 underline-offset-4"
          >
            {COPY.searchSuggest}
          </a>
        </p>
      </div>
    </div>
  </section>
  <script>
    import "../client/category-filter";
    import "../client/live-search";
  </script>
</BaseLayout>
