---
// src/layouts/BaseLayout.astro
import "../styles/global.css";
import IconSprite from "../components/IconSprite.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { COPY } from "../lib/copy";
// The `latin` subset only (not `latin-ext`, task-15-report.md's own reading
// of the brief's "the two font files"): every page's body text and every
// .ff heading sits on the critical rendering path, and Lighthouse's own LCP
// trace named render delay, not the network, as most of the budget overrun —
// exactly what a preload (found before the CSS's own @font-face is parsed)
// fixes. `?url` resolves to the same hashed, cache-busted path global.css's
// own @font-face already emits, so this never drifts from it by hand.
import literata from "../fonts/literata-latin.woff2?url";
import sourceSans from "../fonts/source-sans-3-latin.woff2?url";

interface Props {
  title: string;
  description: string;
  bodyClass?: string;
  // Site-relative path of the 1200×630 share card; the home card by default.
  ogImage?: string;
  // Forwarded to SiteHeader's secondary link as-is; see its own Props for the
  // shape and defaults. A page passes this instead of reaching past the layout.
  header?: { href?: string; label?: string; srOnly?: string; variant?: "back" | "join" };
}
// header-extra forwards into SiteHeader's own "under" slot (annuaire.astro's
// search form, nested inside <header> above the filet per annuaire.html).
// Unused by every other page, so it renders nothing there and those pages'
// output is unchanged.
const { title, description, bodyClass = "", header = {}, ogImage = "/og.png" } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="fr" data-theme="cartoucherie">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="preload" href={sourceSans} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={literata} as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="manifest" href="/manifest.webmanifest" />
    {
      // Without an explicit rel=icon, Chrome still auto-requests /favicon.ico
      // and logs its 404 to the console — Lighthouse's errors-in-console audit
      // (best-practices) catches exactly that. public/favicon.ico (a copy of
      // the PWA icon already declared in manifest.webmanifest) answers both
      // the auto-probe and this link.
    }
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/icon-192.png" type="image/png" />
    <style>
      /* Safe-area insets. Without them the sticky « Appeler » bar sits under the
         iPhone home indicator. None of the four mockups handled this. */
      :root {
        --safe-bottom: env(safe-area-inset-bottom, 0px);
        --safe-left: env(safe-area-inset-left, 0px);
        --safe-right: env(safe-area-inset-right, 0px);
      }
      body {
        padding-left: var(--safe-left);
        padding-right: var(--safe-right);
      }
    </style>
  </head>
  <body class={bodyClass}>
    <a
      href="#contenu"
      class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:m-3 focus:rounded-field focus:bg-white focus:px-4 focus:py-3 focus:text-teal-800"
    >
      {COPY.skipLink}
    </a>
    <IconSprite />
    {
      Astro.slots.has("header-extra") ? (
        <SiteHeader {...header}>
          <slot name="header-extra" slot="under" />
        </SiteHeader>
      ) : (
        <SiteHeader {...header} />
      )
    }
    <main id="contenu">
      <slot />
    </main>
    <SiteFooter />
    {
      // Dynamic import, not a static one: Astro inlines a hoisted script's
      // bundle straight into every page's HTML (no src=, no CSP hash — the
      // project sets no `security.csp`) whenever its own chunk statically
      // imports nothing else and stays under Vite's 4 KB assetsInlineLimit
      // (node_modules/astro/dist/core/build/plugins/plugin-scripts.js,
      // shouldInlineScriptChunk). Both modules here are small enough on
      // their own to qualify, on all 29 pages — verified by building and
      // grepping dist/*/index.html for an inline module script without
      // src= before this change. A dynamic import gives the chunk a
      // dynamicImports entry, which disqualifies it unconditionally, so it
      // ships as the external, `'self'`-permitted file CSP actually allows.
    }
    <script>
      void import("../client/register-sw");
      void import("../client/analytics");
    </script>
  </body>
</html>
