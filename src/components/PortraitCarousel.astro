---
// src/components/PortraitCarousel.astro
// The member's Instagram portrait carousel, rebuilt from its slides rather than
// embedded: Instagram's embed needs a third-party script the CSP blocks, sets
// cookies the privacy page promises never to set, and weighs about 1 MB.
// No mockup covers this block; it borrows the profile's own card language.
//
// Instagram's gesture, without Instagram: one slide per view, swiped by CSS
// scroll-snap, dots underneath. Tapping a slide opens it full screen in a
// native <dialog>. Without JavaScript the swipe still works and the tap opens
// the slide's own image file. Each slide's words are its alt text: the slides
// are text set in images, which a screen reader cannot otherwise read.
// src/client/carousel.ts adds the arrows, the dots and the full-screen view.
import Icon from "./Icon.astro";
import type { Slide } from "../content/schemas";
import { COPY } from "../lib/copy";
import { slideSrc } from "../lib/members";

interface Props {
  slides: Slide[];
}
const { slides } = Astro.props;

const arrow =
  "absolute top-1/2 flex size-11 -translate-y-1/2 items-center justify-center rounded-full bg-white/90 text-teal-900 shadow-md disabled:opacity-0 max-sm:hidden";
---

<div class="mt-6 max-w-[420px]" data-carousel>
  <div class="relative" data-frame>
    <ul
      class="carte flex snap-x snap-mandatory overflow-x-auto rounded-[16px] bg-white [scrollbar-width:none] focus-visible:outline-2 focus-visible:outline-teal-700"
      tabindex="0"
      aria-label={COPY.carouselLabel}
      data-track
    >
      {slides.map((slide, i) => (
        <li class="w-full shrink-0 snap-center">
          <a href={slideSrc(slide.fichier, 1080)} class="block cursor-zoom-in" data-open={i}>
            <img
              src={slideSrc(slide.fichier, 720)}
              alt={slide.texte}
              width="720"
              height="900"
              loading="lazy"
              decoding="async"
              class="block h-auto w-full"
            />
          </a>
        </li>
      ))}
    </ul>
    <button
      type="button"
      class={`${arrow} left-2`}
      aria-label={COPY.carouselPrevious}
      data-prev
      hidden
    >
      <Icon name="chev" class="size-5 rotate-180" />
    </button>
    <button
      type="button"
      class={`${arrow} right-2`}
      aria-label={COPY.carouselNext}
      data-next
      hidden
    >
      <Icon name="chev" class="size-5" />
    </button>
  </div>
  <p class="mt-3 flex justify-center gap-1.5" aria-hidden="true">
    {slides.map((_, i) => (
      <span
        class="size-2 rounded-full bg-neutre-300 data-on:bg-teal-700"
        data-dot
        data-on={i === 0}
      />
    ))}
  </p>

  <dialog
    class="m-0 h-dvh max-h-none w-dvw max-w-none bg-teal-950 p-0 text-white backdrop:bg-teal-950"
    aria-label={COPY.carouselLabel}
    data-lightbox
  >
    <div class="relative h-full" data-frame>
      <ul
        class="flex h-full snap-x snap-mandatory overflow-x-auto [scrollbar-width:none]"
        data-track
      >
        {slides.map((slide) => (
          <li class="flex h-full w-full shrink-0 snap-center items-center justify-center p-4">
            <img
              src={slideSrc(slide.fichier, 1080)}
              alt={slide.texte}
              width="1080"
              height="1350"
              loading="lazy"
              decoding="async"
              class="max-h-full w-auto max-w-full object-contain"
            />
          </li>
        ))}
      </ul>
      <button
        type="button"
        class={`${arrow} left-4`}
        aria-label={COPY.carouselPrevious}
        data-prev
        hidden
      >
        <Icon name="chev" class="size-5 rotate-180" />
      </button>
      <button
        type="button"
        class={`${arrow} right-4`}
        aria-label={COPY.carouselNext}
        data-next
        hidden
      >
        <Icon name="chev" class="size-5" />
      </button>
    </div>
    <button
      type="button"
      class="absolute top-3 right-3 flex size-11 items-center justify-center rounded-full bg-white/90 text-teal-900"
      aria-label={COPY.carouselClose}
      data-close
    >
      <Icon name="fermer" class="size-5" />
    </button>
  </dialog>
</div>

<script>
  import "../client/carousel";
</script>
