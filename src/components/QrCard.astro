---
// src/components/QrCard.astro
// The profile's QR code and its download link, nothing else: a resident shows
// it to a neighbour to scan, the member downloads it for a shop window. It sits
// in the identity card (beside it on desktop, behind a button on a phone). The
// QR image is a build-time file (src/pages/qr/[slug].svg.ts), never generated
// or downloaded by a script — the STANDARDS §3 rule.
import Icon from "./Icon.astro";
import { COPY } from "../lib/copy";

interface Props {
  slug: string;
  nom: string;
  size: number;
}
const { slug, nom, size } = Astro.props;
const file = `/qr/${slug}.svg`;
---

<div class="flex flex-col items-center gap-1">
  <img
    src={file}
    alt={COPY.qrAlt(nom)}
    width={size}
    height={size}
    class="rounded-[12px] bg-white p-2"
    style="box-shadow: inset 0 0 0 1px var(--color-neutre-300)"
  />
  <a
    href={file}
    download={`qr-${slug}.svg`}
    aria-label={COPY.qrDownload}
    class="inline-flex min-h-[44px] items-center gap-1.5 text-[16px] font-semibold text-teal-700 underline decoration-teal-300 underline-offset-4 hover:decoration-teal-600"
  >
    <Icon name="dl" class="size-[18px]" />
    {COPY.qrDownloadShort}
  </a>
</div>
