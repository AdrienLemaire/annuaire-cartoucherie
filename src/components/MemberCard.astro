---
// src/components/MemberCard.astro — frontmatter binds, it does not compute.
// Styleguide block 12 ("la carte-portrait"): the full-card specimen (lines
// 1114-1143, fixed/rectangle, with the star rating and the accroche) and the
// disc specimen (lines 1085-1112, itinerant, on .colly-fond with a white
// ring) — a grid tile for the directory and a category page. One tap
// target — the whole card, wrapped in a single <a> — so it carries no chips
// (a chip inside a link is a link inside a link) and no call button. The
// optional `categories` prop exists only to resolve the disc variant's
// "vient chez vous" icon (homeServiceIcon) — pass it when a caller wants
// that icon; omitting it renders the same text with no icon. That icon is a
// "c-*" sprite id (a category's own icon, src/content/schemas.ts), rendered
// through Icon.astro's own `raw` prop (final-fixes-report.md, I7).
//
// Fixed-variant image height (task-7 fix round 1): the styleguide's generic
// full-card specimen uses h-[190px], but object-cover scales a 128×128
// source by the LARGER of its width and height ratios. In the only grid that
// currently uses this card (the home page's "Vos voisins", a ~154-169px
// column at 360-390px), 190px alone put the height ratio at ×1.484 — past
// the ×1.4 cap — even though the width ratio (×1.20-1.32) was fine. Lowered
// to h-[150px] (index.html:777's own value for this exact tile, not the
// styleguide's wider-context specimen), which keeps both axes under the cap
// with margin at every measured width. See task-7-report.md for the numbers.
//
// Disc-variant fixes (final-fixes-report.md, I6, found while replacing
// carte.astro's own inline third copy of this card): the portrait was
// missing `object-position:50% 22%`, present on styleguide.html's own
// specimen (line 1093) and on every other disc/itinerant portrait in this
// codebase (MemberRow.astro, carte.astro's own "chezvous" grid); and it
// rendered `member.accroche`, which no mockup specimen of this exact card
// does (styleguide.html:1085-1108, index.html's own "Vos voisins" disc
// tile) — removed rather than kept, per "mockups win".
import Icon from "./Icon.astro";
import { COPY } from "../lib/copy";
import { agree } from "../lib/gender";
import { formatNote, hasAddress, homeServiceIcon } from "../lib/members";
import type { Category, Member } from "../content/schemas";

interface Props {
  member: Member;
  priority?: boolean;
  categories?: Category[];
  // carte.astro's own "chezvous" grid is wide (lg:grid-cols-4 over
  // max-w-[1160px], ~275px cells) and wants an equal-height card that fills
  // its cell, unlike the home page's narrow, fixed-width "Vos voisins" rail
  // this component was built for (final-fixes-report.md, I6). Swaps the
  // 176px cap for w-full/h-full rather than forking a third copy of this card.
  fill?: boolean;
}
const { member, priority = false, categories = [], fill = false } = Astro.props;
const fixed = hasAddress(member);
const alt = COPY.portraitAlt(member.nom);
const eager = priority ? "eager" : "lazy";
const homeIcon = fixed ? undefined : homeServiceIcon(member, categories);
---

<a href={`/membre/${member.slug}`} class={`carte-lien block min-w-0 ${fill ? "h-full" : "max-w-[176px]"}`}>
  {
    fixed ? (
      <article class="carte rounded-box bg-white overflow-hidden">
        <img
          src={`/portraits/${member.photo}`}
          alt={alt}
          width="128"
          height="128"
          loading={eager}
          decoding="async"
          class="w-full h-[150px] object-cover"
        />
        <div class="p-4">
          <h3 class="ff break-words mt-2.5 text-[25px] leading-[1.05] text-teal-900">{member.nom}</h3>
          <p class="break-words mt-1 text-corps font-semibold text-neutre-900">{member.metier}</p>
          <p class="break-words mt-1.5 text-[16px] leading-snug text-neutre-700">{member.accroche}</p>
          <p class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-[16px] text-neutre-700">
            {member.nbAvis > 0 && (
              <span class="inline-flex items-center gap-1">
                <Icon name="etoile" class="w-4 h-4 text-sable-700" />
                {formatNote(member.note)}
                <span class="sr-only"> {COPY.ratingOutOf}</span> <span class="text-neutre-600">({member.nbAvis})</span>
              </span>
            )}
            <span class="inline-flex items-center gap-1">
              <Icon name="pin" class="w-4 h-4 text-teal-600" />
              {member.distance}
            </span>
          </p>
        </div>
      </article>
    ) : (
      <article class={`carte colly-fond flex flex-col items-center rounded-box px-4 py-5 text-center ${fill ? "h-full" : ""}`}>
        <img
          src={`/portraits/${member.photo}`}
          alt={alt}
          width="128"
          height="128"
          loading={eager}
          decoding="async"
          class="w-[124px] h-[124px] rounded-full object-cover shadow-carte"
          style="object-position:50% 22%; box-shadow: 0 0 0 3px #fff, var(--shadow-carte);"
        />
        <h3 class="ff break-words mt-3.5 text-[21px] leading-tight text-teal-900">{member.nom}</h3>
        <p class="break-words mt-0.5 text-corps text-neutre-900">{member.metier}</p>
        <p class="mt-2 inline-flex items-center gap-1.5 text-[16px] font-semibold text-teal-800">
          {homeIcon && <Icon raw={homeIcon} class="w-4 h-4 shrink-0 text-teal-600" />}
          {COPY.comesToYou(agree(member.genre, "elle"))}
        </p>
        {member.nbAvis > 0 && (
          <p class="mt-1.5 inline-flex items-center gap-1 text-[16px] text-neutre-700">
            <Icon name="etoile" class="w-4 h-4 text-sable-700" />
            {formatNote(member.note)}
            <span class="sr-only"> {COPY.ratingOutOf}</span> <span class="text-neutre-600">({member.nbAvis})</span>
          </p>
        )}
      </article>
    )
  }
</a>
