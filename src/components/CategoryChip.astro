---
// src/components/CategoryChip.astro
// Styleguide block 20 ("les petites pièces", the ten category pastilles
// specimen, line ~1861): the .chip pill, but as a real <a> at ≥44px —
// block 12's full card shipped it as a non-tappable <span> at ~34px, which
// was the third defect this component originally existed to fix.
//
// The icon (task-9-report.md fix round 1): styleguide's own canonical chip
// carries a "c-*" category icon — categorySchema's `icon` field exists
// precisely so this could render one — and docs/mockups/final/membre.html's
// identity-card chip (line 392-394) confirms it. Referenced directly as
// <svg><use href="#c-…"> rather than through Icon.astro, which unconditionally
// prefixes "i-": MemberCard and MemberRow already do the same for a
// category's own icon.
interface Props {
  slug: string;
  nom: string;
  icon: string;
}
const { slug, nom, icon } = Astro.props;
---

<a
  href={`/categorie/${slug}`}
  class="chip inline-flex min-h-[44px] items-center gap-2 rounded-selector px-3.5 text-[16px] font-semibold"
>
  <svg class="h-[18px] w-[18px]" aria-hidden="true">
    <use href={`#${icon}`} />
  </svg>
  {nom}
</a>
