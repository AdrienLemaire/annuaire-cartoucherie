---
// src/components/Icon.astro
// The one way icons reach markup: a <use> reference into IconSprite.astro's
// <symbol> sheet, never a raw inline <svg><path>.
interface Props {
  name: string;
  class?: string;
}
const { name, class: className = "size-5" } = Astro.props;
---

<svg class={className} aria-hidden="true" focusable="false">
  <use href={`#i-${name}`} />
</svg>
