---
// src/components/SiteHeader.astro
// Styleguide block 09 ("L'en-tête"). The secondary link (right) varies per page —
// docs/mockups/final/annuaire.html points it at "/" labelled « Accueil »;
// docs/mockups/final/membre.html and carte.html point it at "/annuaire"
// labelled « Annuaire » with a screen-reader-only suffix — so it is a prop,
// defaulting to the "back" ("Accueil") case so BaseLayout's prop-less
// <SiteHeader /> keeps rendering that. index.html's own header carries a
// third, structurally different shape instead: no icon, a mailto: href,
// hidden below the sm (640px) breakpoint — variant="join" (task-7-brief.md
// carried item 2). The two existing <a> branches below are byte-identical
// to before this variant was added.
import Icon from "./Icon.astro";
import { COPY } from "../lib/copy";
import { mailtoHref } from "../lib/contact";

interface Props {
  href?: string;
  label?: string;
  srOnly?: string;
  variant?: "back" | "join";
}
const { href = "/", label = COPY.headerBackHome, srOnly, variant = "back" } = Astro.props;
// The wordmark link's own class list is not fixed either: docs/mockups/final/annuaire.html
// and index.html omit `py-1`, docs/mockups/final/membre.html and carte.html include it.
// Those two mockup families are exactly the two variants this component renders — srOnly
// is only ever set on the membre/carte call — so it selects the wordmark's padding too,
// rather than a third prop that would never carry a different value than this today.
const wordmarkClass = `flex items-center gap-2.5 -ml-0.5 min-h-[44px]${srOnly ? " py-1" : ""}`;
---

<header class="sticky top-0 z-40 bg-white/95 backdrop-blur-sm">
  <div class="mx-auto max-w-[1160px] px-5 min-h-16 flex flex-wrap items-center justify-between gap-3">
    {
      // No aria-label here (task-15-report.md): overriding the accessible name
      // wholesale, while the wordmark's own two spans stay visible, is exactly
      // what Lighthouse's label-content-name-mismatch audit (WCAG 2.5.3, Label
      // in Name) catches — the visible text stops being part of the computed
      // name. An sr-only tail adds "accueil" without replacing anything.
    }
    <a href="/" class={wordmarkClass}>
      <Icon name="ventouse" class="w-8 h-8 text-teal-700 shrink-0" />
      <span class="leading-none">
        <span class="block text-[11.5px] uppercase tracking-[.18em] text-neutre-700 font-semibold">
          {COPY.brandEyebrow}
        </span>
        <span class="ff block text-[20px] text-teal-900 leading-tight">{COPY.brandName}</span>
      </span>
      <span class="sr-only">, {COPY.headerBackHome}</span>
    </a>
    {
      variant === "join" ? (
        <a
          href={mailtoHref(COPY.headerJoinSubject)}
          class="hidden sm:inline-flex items-center gap-1.5 min-h-[44px] px-4 rounded-full text-etiquette tracking-normal font-semibold text-teal-700 hover:bg-teal-50"
        >
          {COPY.headerJoin}
        </a>
      ) : (
        <a
          href={href}
          class="inline-flex items-center gap-2 min-h-[44px] px-3.5 rounded-full text-etiquette tracking-normal font-semibold text-teal-700 hover:bg-teal-50"
        >
          <Icon name="retour" class="w-5 h-5" />
          <span>{label}</span>
          {srOnly && <span class="sr-only">{srOnly}</span>}
        </a>
      )
    }
  </div>
  {
    /* docs/mockups/final/annuaire.html nests its search form inside <header>,
       above the filet, so it stays sticky with the wordmark row as the visitor
       scrolls. Every other page leaves this slot empty, which renders nothing —
       so the three variants above stay byte-identical to before this slot
       existed. task-8-brief.md's own carried-over note names this gap. */
    Astro.slots.has("under") && (
      <div class="mx-auto max-w-[1160px] px-5 pb-3">
        <slot name="under" />
      </div>
    )
  }
  <div class="filet h-[3px]"></div>
</header>
