---
// src/components/SiteHeader.astro
// Styleguide block 09 ("L'en-tête"). The wordmark (left) is fixed, copied from
// docs/mockups/final/index.html. The secondary link (right) varies per page —
// docs/mockups/final/annuaire.html points it at "/" labelled « Accueil »;
// docs/mockups/final/membre.html and carte.html point it at "/annuaire"
// labelled « Annuaire » with a screen-reader-only suffix — so it is a prop,
// defaulting to the "Accueil" case so BaseLayout's prop-less <SiteHeader />
// keeps rendering that. The true home page's own "Je veux y figurer" link is
// a structurally different piece of markup (no icon, hidden below sm, a
// mailto href) and isn't covered by this prop: see task-3-report.md.
import Icon from "./Icon.astro";
import { COPY } from "../lib/copy";

interface Props {
  href?: string;
  label?: string;
  srOnly?: string;
}
const { href = "/", label = COPY.headerBackHome, srOnly } = Astro.props;
---

<header class="sticky top-0 z-40 bg-white/95 backdrop-blur-sm">
  <div class="mx-auto max-w-[1160px] px-5 h-16 flex items-center justify-between gap-3">
    <a
      href="/"
      class="flex items-center gap-2.5 -ml-0.5 min-h-[44px]"
      aria-label={COPY.headerHomeAria}
    >
      <Icon name="ventouse" class="w-8 h-8 text-teal-700 shrink-0" />
      <span class="leading-none">
        <span class="block text-[11.5px] uppercase tracking-[.18em] text-neutre-700 font-semibold">
          {COPY.brandEyebrow}
        </span>
        <span class="ff block text-[20px] text-teal-900 leading-tight">{COPY.brandName}</span>
      </span>
    </a>
    <a
      href={href}
      class="inline-flex items-center gap-2 min-h-[44px] px-3.5 rounded-full text-etiquette tracking-normal font-semibold text-teal-700 hover:bg-teal-50"
    >
      <Icon name="retour" class="w-5 h-5" />
      <span>{label}</span>
      {srOnly && <span class="sr-only">{srOnly}</span>}
    </a>
  </div>
  <div class="filet h-[3px]"></div>
</header>
