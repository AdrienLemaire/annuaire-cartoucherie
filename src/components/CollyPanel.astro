---
// src/components/CollyPanel.astro
// Styleguide block "Les états Colly" (id="b-colly") plus the other mockup
// specimen it documents but does not repeat inline: the accueil "salut"
// panel (index.html, bg-sable-100) and the "aucun résultat" panel
// (index.html/annuaire.html/styleguide, bg-teal-50). Deviation from the
// task-6 brief, reported in task-6-report.md: the brief says CollyPanel
// applies .colly-fond, but no mockup specimen uses that gradient for this
// panel — each pose keeps its own flat background exactly as composed, so
// this table is data (dims, background, disc, title size), not computed
// logic, and every class list is copied verbatim from its specimen.
// Colly's pencil sketches are opaque paper: .croquis (multiply blend +
// greyscale) bleeds the paper into the panel colour so only the graphite
// survives.
//
// Dropped "couleur" and "joyeux" (final-fixes-report.md, M14): zero callers.
// "couleur" was never a real CollyPanel pose to begin with — it existed only
// as a guess at how the "salut" shape might carry the one transparent,
// colour asset (colly-couleur.png/.webp), which SearchBar.astro renders
// directly instead, its only real use. "joyeux" (the profile avis
// invitation, membre.html's own Plan 2 feature — ReviewsSlot.astro's own
// comment) has no caller in Plan 1 either. Their own asset, colly-joyeux.*,
// is deleted from public/colly/ with them; colly-couleur.* stays, since
// SearchBar.astro still uses it.
//
// task-15-report.md, fix round 1: every pose's <img> is now the <picture>'s
// fallback, alongside a WebP <source> — see SearchBar.astro's own comment on
// colly-couleur for the reasoning. Same dimensions, same visible quality at
// the small size a disc actually renders these at, both formats re-encoded,
// neither a resize or a redraw.
const PANELS = {
  // Full-bleed: the sand runs edge to edge, the content keeps to the page's
  // own 1160 px column, aligned with the sections above and the footer.
  salut: {
    dims: { width: 320, height: 305 },
    section: "pt-6",
    panel: "relative bg-sable-100 py-8 overflow-hidden",
    content: "relative mx-auto max-w-[1160px] px-5",
    disc: "mx-auto w-[168px] h-[168px] rounded-full bg-sable-200 overflow-hidden grid place-items-center",
    discStyle: "box-shadow: inset 0 0 0 2px var(--color-sable-300), 0 0 0 8px var(--color-sable-50)",
    img: "croquis w-[190px] h-auto",
    title: "ff mt-6 text-[32px] leading-tight text-teal-950",
    text: "mt-3 text-corps text-teal-950",
  },
  triste: {
    dims: { width: 260, height: 260 },
    section: "px-5 py-6",
    panel: "rounded-[24px] bg-teal-50 px-6 py-9 text-center",
    disc: "mx-auto w-[132px] h-[132px] rounded-full bg-teal-50 overflow-hidden grid place-items-center",
    discStyle: "",
    img: "croquis w-[150px] h-auto -mt-2",
    title: "ff mt-3 text-[26px] text-teal-900",
    text: "mt-2 text-corps text-neutre-800",
  },
} as const;

interface Props {
  pose: "salut" | "triste";
  title: string;
  text?: string;
}
const { pose, title, text } = Astro.props;
const p = PANELS[pose];
const headingId = `t-colly-${pose}`;
// "salut" sits over the .ventouses top decoration: its content needs its own
// stacking context (a "relative" wrapper) to paint above it — the exact
// structure the mockup uses. "triste" has no ventouses, so the disc and body
// are direct, unwrapped children of the panel.
const hasVentouses = pose === "salut";
---

<section class={p.section} aria-labelledby={headingId}>
  <div class={p.panel}>
    {hasVentouses ? (
      <>
        <div
          class="ventouses pointer-events-none absolute inset-x-0 top-0 h-[250px]"
          style="-webkit-mask-image:linear-gradient(to bottom,#000 58%,transparent); mask-image:linear-gradient(to bottom,#000 58%,transparent)"
        />
        <div class={PANELS.salut.content}>
          <div class={p.disc} style={p.discStyle}>
            <picture>
              <source srcset={`/colly/colly-${pose}.webp`} type="image/webp" />
              <img src={`/colly/colly-${pose}.png`} alt="" width={p.dims.width} height={p.dims.height} class={p.img} />
            </picture>
          </div>
          <div>
            <h2 id={headingId} class={p.title}>{title}</h2>
            {text && <p class={p.text}>{text}</p>}
            <slot />
          </div>
        </div>
      </>
    ) : (
      <>
        <div class={p.disc} style={p.discStyle}>
          <picture>
            <source srcset={`/colly/colly-${pose}.webp`} type="image/webp" />
            <img src={`/colly/colly-${pose}.png`} alt="" width={p.dims.width} height={p.dims.height} class={p.img} />
          </picture>
        </div>
        <div>
          <h2 id={headingId} class={p.title}>{title}</h2>
          {text && <p class={p.text}>{text}</p>}
          <slot />
        </div>
      </>
    )}
  </div>
</section>
