---
// src/components/NeedsIndex.astro
// Styleguide block "L'index « Je cherche… »" (id="b-index"): ten need
// phrases as a numbered index, compacted from ~1100px to 582px at 390px
// wide by moving the keyword gloss off the display line (task-6 brief).
// The 01-10 numbering is a CSS counter, not a padStart in frontmatter:
// frontmatter binds data, it does not compute it.
// The empty category (task-6 brief: "the empty category is shown, not
// hidden") renders greyed with no link and a mailto: to offer a name —
// the one place a visitor can suggest a neighbour. While the directory is
// small (groupsEmptyCategories), the empty ones share a single closing line.
import { COPY } from "../lib/copy";
import { mailtoHref } from "../lib/contact";
import { formatMemberCount, groupsEmptyCategories } from "../lib/members";
import type { CategoryWithCount } from "../lib/members";

interface Props {
  categories: CategoryWithCount[];
  memberCount: number;
}
const { categories, memberCount } = Astro.props;
const grouped = groupsEmptyCategories(memberCount) ? categories.filter((c) => c.count === 0) : [];
const listed = categories.filter((c) => !grouped.includes(c));
---

<ol class="list-none m-0 p-0 [counter-reset:besoin] sm:grid sm:grid-cols-2 sm:gap-x-8">
  {
    listed.map((c) => (
      <li class="[counter-increment:besoin]">
        {c.count === 0 ? (
          <div class="flex items-start gap-3 px-5 py-1.5 min-h-[56px]">
            <span class="tnum mt-1 w-6 shrink-0 text-[16px] font-bold text-neutre-600 before:content-[counter(besoin,decimal-leading-zero)]" />
            <span class="min-w-0 flex-1">
              <span class="ff block text-besoin text-neutre-600">{c.besoin}</span>
              <span class="mt-0.5 block text-[16px] leading-[1.3] text-neutre-700">
                {c.nom} · <span class="font-semibold text-neutre-800">{formatMemberCount(c.count, c.genders)}</span> —{" "}
                <a
                  class="font-semibold text-teal-700 underline decoration-teal-300 underline-offset-4 hover:decoration-teal-600"
                  href={mailtoHref(COPY.searchSuggestSubject(c.nom))}
                >
                  {COPY.searchSuggest}
                </a>
              </span>
            </span>
          </div>
        ) : (
          <a class="besoin flex items-start gap-3 px-5 py-1.5 min-h-[56px]" href={`/categorie/${c.slug}`}>
            <span class="num tnum mt-1 w-6 shrink-0 text-[16px] font-bold text-neutre-600 before:content-[counter(besoin,decimal-leading-zero)]" />
            <span class="min-w-0 flex-1">
              <span class="ff block break-words text-besoin text-teal-800">{c.besoin}</span>
              <span class="mt-0.5 block text-[16px] leading-[1.15] text-neutre-700">
                {c.motsCles.slice(0, 3).join(", ")} · <span class="font-semibold text-neutre-800">{formatMemberCount(c.count, c.genders)}</span>
              </span>
            </span>
          </a>
        )}
      </li>
    ))
  }
</ol>
{
  grouped.length > 0 && (
    <p class="px-5 py-3 text-[16px] leading-[1.3] text-neutre-700">
      {COPY.needsEmptyGroup(grouped.map((c) => c.nom))}{" "}
      <a
        class="font-semibold text-teal-700 underline decoration-teal-300 underline-offset-4 hover:decoration-teal-600"
        href={mailtoHref(COPY.searchNoMatchSubject)}
      >
        {COPY.searchSuggest}
      </a>
    </p>
  )
}
