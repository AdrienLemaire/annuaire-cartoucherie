{
  "name": "annuaire-cartoucherie",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "node scripts/sync-content.mjs",
    "dev": "astro dev",
    "prebuild": "node scripts/sync-content.mjs",
    "build": "astro build",
    "preview": "astro preview --port 4321",
    "pretest": "node scripts/sync-content.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "prelint": "node scripts/sync-content.mjs",
    "lint": "astro check && eslint . && tsc --noEmit && test -z \"$(find src -name index.ts)\" && jscpd src",
    "guard": "node scripts/forbidden.mjs",
    "guard:dist": "node scripts/forbidden-dist.mjs",
    "verify:history": "node scripts/verify-history.mjs",
    "budgets": "node scripts/budgets.mjs",
    "lighthouse": "lhci autorun",
    "format": "prettier --write .",
    "deploy": "test -n \"$CONTENT_DIR\" || { echo 'deploy: set CONTENT_DIR to the private checkout — never deploy the fixture'; exit 1; }; test -n \"$SITE_URL\" || { echo 'deploy: set SITE_URL to the URL this deploy serves — every QR code encodes it'; exit 1; }; npm run build && npm run guard:dist && wrangler deploy",
    "prepare": "husky"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.3",
    "daisyui": "^5.7.38",
    "qrcode": "^1.5.4",
    "satori": "^0.33.4",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "wawoff2": "^2.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.11",
    "@axe-core/playwright": "^4.14.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "@types/qrcode": "^1.5.6",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "husky": "^9.1.7",
    "jscpd": "^5.4.1",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.1",
    "wrangler": "^4.151.2"
  }
}
